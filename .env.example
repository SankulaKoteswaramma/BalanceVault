# ==========================================
# BalanceVault Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL
# ==========================================

# Server Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://neondb_owner:npg_oYBzu5sdZA3G@ep-muddy-tooth-besapw0o-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Database Least-Privilege Role URLs (Optional for enhanced security isolation)
DB_APP_RUNTIME_URL=postgresql://bv_app_runtime:runtime_secure_password@localhost:5432/balancevault?schema=public
DB_READONLY_URL=postgresql://bv_readonly_auditor:readonly_secure_password@localhost:5432/balancevault?schema=public

# Redis Configuration (Rate Limiting & Caching)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Session Expiry
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_32_chars!
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super_secret_refresh_key_replace_in_production_min_32_chars!
REFRESH_TOKEN_EXPIRES_IN=7d

# First-Administrator Bootstrap Secret (Cryptographically Secure Key)
BOOTSTRAP_SECRET=bootstrap_token_replace_with_secure_random_hex_key_32_bytes!

# Rate Limiting Parameters
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=100
